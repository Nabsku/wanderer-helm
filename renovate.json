{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": [
    "dockerfile",
    "github-actions",
    "pip_requirements",
    "custom.regex"
  ],
  "schedule": ["before 6am on Monday"],
  "dependencyDashboard": true,
  "automerge": false,
  "prConcurrentLimit": 10,
  "labels": ["dependencies"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Manage image tags in Helm values",
      "managerFilePatterns": ["/(^|/)values\\.yaml$/"],
      "matchStrings": [
        "repository:\\s*(?<depName>[^\\s#]+)\\s*\\n\\s*tag:\\s*[\\\"']?(?<currentValue>[^\\\"'\\s#]+)[\\\"']?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Manage pinned container images used by workflows",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": [
        "(?<depName>ghcr\\.io/yannh/kubeconform):(?<currentValue>v?[0-9]+\\.[0-9]+\\.[0-9]+)",
        "(?<depName>kindest/node):(?<currentValue>v?[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Keep Wanderer web and database tags synchronized by the upstream PR",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "flomp/wanderer-web",
        "flomp/wanderer-db"
      ],
      "enabled": false
    },
    {
      "description": "Group GitHub Actions maintenance",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions dependencies",
      "groupSlug": "github-actions"
    },
    {
      "description": "Group Python runtime maintenance",
      "matchManagers": ["pip_requirements"],
      "groupName": "Python dependencies",
      "groupSlug": "python-dependencies"
    }
  ]
}
